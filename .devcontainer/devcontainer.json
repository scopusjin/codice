{
  "name": "Mortem · Python 3.12",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["docs/sviluppo.md", "Stima_epoca_decesso.py"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "postCreateCommand": "python -m pip install -r requirements.txt && python -m pip check",
  "postAttachCommand": {
    "server": "python -m streamlit run Stima_epoca_decesso.py"
  },
  "portsAttributes": {
    "8501": {"label": "Mortem", "onAutoForward": "openPreview"}
  },
  "forwardPorts": [8501]
}
